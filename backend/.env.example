# Copie para .env.dev para desenvolvimento local. Nunca use estes valores em producao.
# Valores aceitos: dev, test, production. Producao so usa ambiente injetado.
NODE_ENV=dev
PORT=3010
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_SERVICE=blog-api
PUBLIC_SITE_URL=http://localhost:5173
# Vazio/false ou IPs/CIDRs dos proxies realmente controlados, separados por virgula.
# Exemplo apenas se o proxy local for confiavel: 127.0.0.1/32,::1/128
# true e redes /0 sao rejeitados; nao confiar em toda a internet.
TRUST_PROXY=false

# PostgreSQL local do docker-compose-develop.yml; dados ficticios de desenvolvimento.
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=blog_dev
DB_USERNAME=blog_app
DB_PASSWORD=blog_local_only
DB_POOL_MAX=5
DB_ACQUIRE_MS=5000
DB_STATEMENT_TIMEOUT_MS=3000
# A conta de migracao tem DDL; a aplicacao usa apenas a conta DB_* acima.
MIGRATOR_DB_HOST=127.0.0.1
MIGRATOR_DB_PORT=5432
MIGRATOR_DB_NAME=blog_dev
MIGRATOR_DB_USERNAME=blog_migrator_local
MIGRATOR_DB_PASSWORD=blog_migrator_local_only
# Aplicar migrations explicitamente antes de iniciar a API. Nunca gerar schema implicitamente.
SYNC=false
