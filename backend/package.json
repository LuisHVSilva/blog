{
  "name": "blog-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/main.js",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev:database": "docker compose --env-file .env.dev -f docker-compose-develop.yml up -d --wait postgres",
    "dev": "npm run dev:database && npm run dev:api",
    "dev:compose": "docker compose --env-file .env.dev -f docker-compose-develop.yml up --build",
    "production:compose": "docker compose --env-file .env.production up --build",
    "dev:debug": "npm run dev:database && cross-env NODE_ENV=dev node --inspect-brk --import tsx --watch src/main.ts",
    "start": "node dist/src/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:api": "node scripts/test.mjs api",
    "build": "node scripts/build.mjs",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev:api": "cross-env NODE_ENV=dev tsx watch src/main.ts",
    "test:database:up": "docker compose -f docker-compose-test.yml up -d --wait postgres",
    "test:database:down": "docker compose -f docker-compose-test.yml down",
    "migrate": "node dist/scripts/migrate.js up",
    "migrate:status": "node dist/scripts/migrate.js status",
    "content:validate": "node dist/src/modules/publishing/adapters/cli/validate-content.js",
    "content:import": "node dist/src/modules/publishing/adapters/cli/import-content.js",
    "content:publish": "node dist/src/modules/publishing/adapters/cli/publication-operation.js publish",
    "content:unpublish": "node dist/src/modules/publishing/adapters/cli/publication-operation.js unpublish",
    "content:archive": "node dist/src/modules/publishing/adapters/cli/publication-operation.js archive",
    "content:restore": "node dist/src/modules/publishing/adapters/cli/publication-operation.js restore",
    "seed:local": "node dist/scripts/seed-local.js",
    "content:export": "node dist/src/modules/publishing/adapters/cli/export-snapshot.js",
    "release:smoke": "node scripts/release-smoke.mjs",
    "restore:guard": "node scripts/restore.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22.20.2",
    "@types/supertest": "7.2.1",
    "cross-env": "^10.1.0",
    "eslint": "10.10.0",
    "supertest": "7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "mdast-util-to-string": "^4.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "4.5.4"
  }
}
