# Credentials and local environment configuration must never enter a build context.
.env
.env.*
!.env.example
!.env.*.example

# Dependencies and generated/local-only artifacts are restored or created in-container.
node_modules/
dist/
tmp/
out-tsc/
LOGS/

# Repository and editor metadata are not required at runtime.
.git/
.gitignore
.idea/
.vscode/
*.log
